# Neon pooled connection string for application queries
DATABASE_URL=

# Direct, unpooled Neon connection string for schema migrations
DATABASE_URL_UNPOOLED=

# Comma-separated exact origins allowed to call this API from browsers.
# Keep this limited to the Festora staging frontend until production cutover.
CORS_ORIGINS=http://localhost:3000

# Used to sign/verify application tokens once auth is implemented.
# Generate a long random value; never commit the real value.
AUTH_SECRET=

# Optional: identify the deployment environment in health responses.
APP_ENV=development