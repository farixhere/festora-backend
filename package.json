{
  "name": "festora-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Festora production API powered by Neon PostgreSQL",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build": "npm run typecheck"
  },
  "dependencies": {
    "@vercel/functions": "^2.2.12",
    "drizzle-orm": "^0.44.5",
    "nodemailer": "^6.9.16",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.5",
    "@vercel/node": "^5.3.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2",
    "vercel": "^48.1.0"
  }
}
